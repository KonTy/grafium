<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Read/write the graph files in Documents/ -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <application
        android:allowBackup="false"
        android:label="Grafium"
        android:supportsRtl="true">

        <!-- Voice command receiver: SilentPulse discovers this via ASSISTANT_CAPABLE.

             DEPRECATED (2025): the standalone `com.grafium.companion` app is
             superseded by the Tauri Android build (`com.grafium.app`), which
             shares the same Rust NLU (grafium_core::assistant) as the desktop
             UI via JNI. This receiver is disabled so both apps cannot fire on
             the same broadcast. To revive the standalone companion, set
             android:enabled="true" — but note that its command grammar is
             frozen and won't get parity with the Tauri app.
        -->
        <receiver
            android:name=".VoiceCommandReceiver"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="com.silentpulse.action.ASSISTANT_CAPABLE" />
                <action android:name="com.silentpulse.action.EXECUTE_COMMAND" />
                <action android:name="com.silentpulse.action.REQUEST_SCHEMA" />
            </intent-filter>
            <!-- Command prefixes: if transcript starts with any of these, route here directly -->
            <meta-data
                android:name="com.silentpulse.command_prefixes"
                android:value="journal,note,log,jot,todo,to do,task,add task,add todo,add note,read journal,read tasks,read my journal,read my tasks,read my to-do,read my todos,remind me to" />
        </receiver>

        <!-- Minimal activity to configure active graph -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="Grafium">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Full-screen ink capture activity for stylus handwriting -->
        <activity
            android:name=".ink.InkActivity"
            android:exported="false"
            android:label="Grafium Ink"
            android:windowSoftInputMode="stateHidden"
            android:screenOrientation="unspecified"
            android:configChanges="orientation|screenSize|screenLayout" />

    </application>

    <!-- Allow SilentPulse to discover us -->
    <queries>
        <package android:name="com.silentpulse.messenger" />
    </queries>

</manifest>
